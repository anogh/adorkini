                            'city' => $customer->get_billing_city(),
                            'postcode' => $customer->get_billing_postcode(),
                            'country' => $customer->get_billing_country(),
                            'phone' => $customer->get_billing_phone()
                        );
                    }
                }
                
                if (!empty($addresses)) :
                    foreach ($addresses as $id => $addr) : ?>
