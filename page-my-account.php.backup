<script>
(function() {
    // Handle URL hash fragments for internal navigation - runs immediately
    const handleHash = () => {
        const hash = window.location.hash;
        if (!hash) return;
        
        const hashValue = hash.substring(1); // Remove '#'
        let view = '';

        // Map hash values to view parameters
        const hashMap = {
            'account-details': 'personal-info',
            'edit-account': 'personal-info',
            'personal-info': 'personal-info',
            'orders': 'orders',
            'edit-address': 'addresses',
            'addresses': 'addresses'
        };

        view = hashMap[hashValue];

        if (view) {
            // Redirect immediately to the correct ?view= parameter
            window.location.replace('<?php echo esc_url($account_url); ?>?view=' + view);
        }
    };

    // Run immediately (before DOM is ready for faster redirect)
    handleHash();

    // Also handle hash changes for in-page navigation
    window.addEventListener('hashchange', handleHash);
})();
</script>

<?php get_footer(); ?>
