                if (empty($addresses)) {
                    $customer = new WC_Customer($user_id);
                    if ($customer->get_billing_address_1()) {
                        $addresses[1] = array(
                            'first_name' => $customer->get_billing_first_name(),
                            'last_name' => $customer->get_billing_last_name(),
