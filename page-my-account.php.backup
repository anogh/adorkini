                                    <a href="<?php echo esc_url($order->get_view_order_url()); ?>" class="inline-flex items-center px-3 py-1.5 text-xs font-medium bg-primary text-white rounded hover:bg-primary/90 transition-colors"><?php echo __t('View Details'); ?></a>
